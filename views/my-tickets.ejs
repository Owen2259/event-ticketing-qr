<%- include('partials/header') %>
<h1>My tickets</h1>
<% if (!tickets.length) { %>
  <p>You have no tickets yet. <a href="/events">Browse events</a></p>
<% } %>
<% tickets.forEach(function (ticket) { %>
  <div class="card wide">
    <h2><%= ticket.event_name %></h2>
    <p><%= formatDate(ticket.event_datetime) %> &middot; <%= ticket.venue %></p>
    <p><%= ticket.ticket_type %> ticket &middot; Status: <%= ticket.status %></p>
    <p>Code: <strong><%= ticket.code %></strong></p>
  </div>
<% }) %>
<%- include('partials/footer') %>