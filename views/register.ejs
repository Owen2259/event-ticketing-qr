<%- include('partials/header') %>
<h1>Register</h1>
<% if (errors.length) { %>
  <div class="errors"><ul><% errors.forEach(function (e) { %><li><%= e %></li><% }) %></ul></div>
<% } %>
<form method="post" action="/register" class="card" novalidate>
  <label>Full name <input type="text" name="name" value="<%= form.name || '' %>"></label>
  <label>Email <input type="email" name="email" value="<%= form.email || '' %>"></label>
  <label>Password <input type="password" name="password"></label>
  <fieldset>
    <legend>I am registering as</legend>
    <label class="inline"><input type="radio" name="role" value="attendee" <%= form.role !== 'organiser' ? 'checked' : '' %>> Attendee</label>
    <label class="inline"><input type="radio" name="role" value="organiser" <%= form.role === 'organiser' ? 'checked' : '' %>> Organiser</label>
  </fieldset>
  <button type="submit">Create account</button>
</form>
<p>Already registered? <a href="/login">Log in</a></p>
<%- include('partials/footer') %>