<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>EventTix</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
<nav class="nav">
  <a class="brand" href="/">EventTix</a>
  <div class="links">
    <a href="/events">Events</a>

    <% if (user) { %>
      <% if (user.role === 'attendee') { %>
        <a href="/my-tickets">My tickets</a>
      <% } %>
      
      <% if (user.role === 'organiser') { %>
        <a href="/my-events">My events</a>
        <a href="/events/new">Create event</a>
      <% } %>
      
      <span class="who"><%= user.name %> (<%= user.role %>)</span>
      <form method="post" action="/logout"><button type="submit" class="linklike">Log out</button></form>
    <% } else { %>
      <a href="/login">Log in</a>
      <a href="/register">Register</a>
    <% } %>
  </div>
</nav>
<main class="container">